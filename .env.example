# Copy to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string (Neon/Vercel Postgres). Used for the waiver DB.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random secret used to sign the staff-session cookie for /staff/* pages.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Shared password for FBMBA volunteers to access /staff (day-of waiver
# check-in lookup + CSV export). Rotate as needed — it's a single shared
# password, not per-user accounts.
STAFF_PASSWORD=

# Resend API key — sends inquiry emails and waiver confirmation emails.
RESEND_API_KEY=
